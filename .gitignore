# Re-derivable evidence — never the root of trust (PF-10: replicable > archived).
# Verdicts, ledgers and logs are regenerated by re-running the line on a clean clone.
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# Verdict-bus artifacts (the verifier writes them; protected by hooks + this ignore)
.proof/
**/.proof/
.meta_check/

# Produced products of factories (re-derived by the line; not source)
factories/*/build/
**/build/

# Product instances (R1, ADR-015): a `products/<p>/` instance commits only `product.yml` (its
# domain blueprint) + `pinned_verdict.json` (its pin). The EFFECTIVE spec + materialized line are
# re-derived from `product.yml` on every run (like build/ + .proof/ — never the root of trust).
factories/*/products/*/factory.spec.yml
factories/*/products/*/stations/

# Gradle's transient local cache (daemon/incremental state). Tracked source = wrapper + *.kts + sources;
# .gradle/ is regenerable runtime state (a product line's lives under build/, but a factory-root module
# like domain_gen would leak it without this). Never the root of trust.
.gradle/
**/.gradle/

# Generation briefs (C1): the blueprint slice handed to a `generate` slot's generator.
# Re-derivable from spec data; INPUT to the generator, never the root of trust.
.gen/
**/.gen/

# Tier 0 memory cache (journal de hechos + métricas series): derivado, regenerable, NUNCA
# autoridad (la verdad vive en docs+git). Gitignored por ADR-007/008. Borrar y regenerar es seguro.
.metamem/
.claude/metrics/
metrics.jsonl

# Secrets — never committed
.env
.env.*
!.env.example
