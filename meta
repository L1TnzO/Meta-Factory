#!/usr/bin/env bash
# `meta` — thin shim over the Meta-Factory CLI. Puts src/ on PYTHONPATH and dispatches.
# The external CI and the hooks invoke `python3 meta <verb>` (a one-line transport).
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="${HERE}/src${PYTHONPATH:+:${PYTHONPATH}}"
exec python3 -m metafactory.cli "$@"
