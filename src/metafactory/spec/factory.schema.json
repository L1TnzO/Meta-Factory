{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://meta-factory/factory.schema.json",
  "title": "factory-spec",
  "description": "The SDD contract of a factory in 6 layers (ADR-003, ARCHITECTURE §5; v2/A1). L0 factory · L1 domain (capabilities) · L2 line (station_sequence) · L3 machinery · L4 factory_substrate · L5 requirements. The canonical enforcement is metafactory.spec.validator (zero-dep); this schema is the declarative mirror. ADR-012: no technology name is whitelisted anywhere — `tech`/`toolchain` are free DATA the plan chose.",
  "type": "object",
  "required": ["factory", "domain", "factory_substrate", "requirements"],
  "properties": {
    "factory": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "name": {"type": "string"},
        "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "maturity": {"type": "string"}
      }
    },
    "domain": {
      "type": "object",
      "required": ["produces", "station_sequence"],
      "properties": {
        "produces": {"type": "string"},
        "target_framework": {"type": "object"},
        "required_primitives": {
          "type": "array",
          "items": {"$ref": "#/$defs/primitive"},
          "description": "L1 design input: the DES-x primitives the domain requires (the skill provides a tech for each)."
        },
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
        "product_capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
        "station_sequence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "activation": {"type": "string", "enum": ["always", "optional", "off"]},
              "status": {"$ref": "#/$defs/status"},
              "depends_on": {"type": "array", "items": {"type": "string"}},
              "proof_checks": {"type": "array", "items": {"$ref": "#/$defs/proof_check"}}
            }
          }
        },
        "product": {"type": "object", "description": "domain payload for codegen substitution"},
        "provision_modes": {"type": "array"},
        "proof_check_types": {"type": "array"}
      }
    },
    "machinery": {
      "type": "object",
      "description": "L3 — harness/mcp/infra the PLAN chose, as DATA (ADR-012); not opined by the substrate.",
      "properties": {
        "harness": {"$ref": "#/$defs/machinery_section"},
        "mcp": {"$ref": "#/$defs/machinery_section"},
        "infra": {"$ref": "#/$defs/machinery_section"}
      }
    },
    "factory_substrate": {
      "type": "object",
      "required": ["anti_rubber_stamp_column", "verdict_bus"],
      "properties": {
        "anti_rubber_stamp_column": {"const": true},
        "verdict_bus": {
          "type": "object",
          "required": ["max_lines"],
          "properties": {"max_lines": {"type": "integer", "minimum": 1}}
        }
      }
    },
    "requirements": {
      "type": "object",
      "properties": {
        "functional": {"$ref": "#/$defs/reqlist"},
        "nonfunctional": {"$ref": "#/$defs/reqlist"}
      }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["built", "declared-deferred", "planned"],
      "description": "SAFE-7: honest status; aspiration is never confused with reality."
    },
    "primitive": {
      "type": "string",
      "pattern": "^DES-[0-9]+$",
      "description": "the design primitive (CONCEPT) a tech provides — never a tech name (ADR-012)."
    },
    "capability": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "invariant": {"type": "string"},
        "statement": {"type": "string", "description": "legacy alias for invariant"},
        "artifact": {"type": "string"},
        "proof": {"type": "string"},
        "primitive": {"$ref": "#/$defs/primitive"},
        "tech": {"type": "string", "description": "the technology the plan chose (free DATA)"},
        "status": {"$ref": "#/$defs/status"}
      }
    },
    "proof_check": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "kind": {"type": "string"},
        "cmd": {"type": ["string", "array"]},
        "runs_in": {"type": "string", "enum": ["factory_env", "product_env"]},
        "toolchain": {"type": "string", "description": "the toolchain the plan chose (free DATA)"},
        "status": {"$ref": "#/$defs/status"}
      }
    },
    "machinery_section": {
      "type": "object",
      "properties": {
        "tech": {"type": "string"},
        "primitive": {"$ref": "#/$defs/primitive"},
        "status": {"$ref": "#/$defs/status"}
      }
    },
    "reqlist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "satisfied_by"],
        "properties": {
          "id": {"type": "string", "pattern": "^REQ-[A-Z]+-[0-9]{3}$"},
          "statement": {"type": "string"},
          "acceptance": {"type": "string"},
          "satisfied_by": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "verified_by": {"type": "array", "items": {"type": "string"}},
          "capability": {"type": "string", "description": "the L1 capability id this requirement fulfills — the L5→L1 edge of the build evidence tree (C4); a phantom capability is refused by the validator."}
        }
      }
    }
  }
}
