{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://meta-factory/factory.schema.json",
  "title": "factory-spec",
  "description": "The SDD contract of a factory (ADR-003, ARCHITECTURE §5). Two halves: domain (per-factory) and factory_substrate (standardized by the Meta-Factory). The canonical enforcement is metafactory.spec.validator (zero-dep); this schema is the declarative mirror.",
  "type": "object",
  "required": ["factory", "domain", "factory_substrate", "requirements"],
  "properties": {
    "factory": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "name": {"type": "string"},
        "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "maturity": {"type": "string"}
      }
    },
    "domain": {
      "type": "object",
      "required": ["produces", "station_sequence"],
      "properties": {
        "produces": {"type": "string"},
        "target_framework": {"type": "object"},
        "product_capabilities": {"type": "array"},
        "station_sequence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "activation": {"type": "string", "enum": ["always", "optional", "off"]}
            }
          }
        },
        "product": {"type": "object", "description": "domain payload for codegen substitution"},
        "provision_modes": {"type": "array"},
        "proof_check_types": {"type": "array"}
      }
    },
    "factory_substrate": {
      "type": "object",
      "required": ["anti_rubber_stamp_column", "verdict_bus"],
      "properties": {
        "anti_rubber_stamp_column": {"const": true},
        "verdict_bus": {
          "type": "object",
          "required": ["max_lines"],
          "properties": {"max_lines": {"type": "integer", "minimum": 1}}
        }
      }
    },
    "requirements": {
      "type": "object",
      "properties": {
        "functional": {"$ref": "#/$defs/reqlist"},
        "nonfunctional": {"$ref": "#/$defs/reqlist"}
      }
    }
  },
  "$defs": {
    "reqlist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "satisfied_by"],
        "properties": {
          "id": {"type": "string", "pattern": "^REQ-[A-Z]+-[0-9]{3}$"},
          "statement": {"type": "string"},
          "satisfied_by": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
